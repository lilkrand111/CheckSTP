{
	servers {
		timeouts {
			read_header 10s
			read_body {$PROXY_UPLOAD_TIMEOUT:130s}
			idle 60s
		}
	}
	grace_period 210s
}

{$SITE_ADDRESS} {
	# Reports are repetitive JSON: compression shrinks them many times over.
	encode zstd gzip
	# Access log goes to the container log, which Compose rotates. Caddy redacts
	# cookies itself; the CSRF token is removed here.
	log {
		format filter {
			wrap json
			fields {
				request>headers>X-Csrf-Token delete
			}
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	request_body {
		max_size {$MAX_REQUEST_BODY_BYTES:22020096}
	}
	reverse_proxy app:8000 {
		# No request buffering or POST retries. Caddy replaces untrusted X-Forwarded-*.
		transport http {
			dial_timeout 5s
			response_header_timeout {$PROXY_RESPONSE_TIMEOUT:200s}
		}
	}
}

:80 {
	respond "Unknown host" 421
}
